---
import { Avatar } from '../../core/domain/Avatar';
import { avatarSets } from '../../core/domain/AvatarSet';
import { avatarIdsMap } from '../../core/domain/AvatarId';
import { avatarSizes } from '../../core/domain/AvatarSize';
import { avatarFormats } from '../../core/domain/AvatarFormat';
import AvatarCode from '../../components/AvatarCode.astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const avatar = Avatar.fromUrl(Astro.url);
---

<Layout
	title='Exavatar - Dynamic Avatar Generation API | Create Beautiful Avatars Instantly'
	description='Generate stunning, customizable avatars with our powerful API. Choose from multiple styles, sizes, and formats. Perfect for developers building modern applications.'>
	<header
		class='grid-box box-height-2 col-[1/13] row-[3/5] grid grid-flow-row auto-rows-min content-center md:col-[3/11] md:row-[2/4]'>
		<h1 class='content-end text-center text-3xl font-semibold'>Avatar Playground</h1>
		<p class='text-md line-clamp-2 content-center text-center text-balance'>
			Create and customize beautiful avatars with our powerful API. Choose from multiple styles,
			adjust colors, and generate high-quality images instantly.
		</p>
	</header>

	<main class='contents'>
		<section
			class='grid-box box-height-6 grid-cross-br relative col-[3/11] row-[6/12] md:col-[4/6] md:row-[6/12]'>
			{
				avatar.size.value && (
					<span class='badge-secondary absolute top-2 right-2 z-20'>
						{avatar.size.value}x{avatar.size.value}
					</span>
				)
			}

			<img
				id='preview'
				class='absolute inset-0 z-10 mx-auto block aspect-square h-full object-cover p-1'
				src={avatar.imagesrc}
				alt='Avatar Preview'
				fetchpriority='high'
				decoding='sync'
			/>
		</section>

		<form
			method='GET'
			action=''
			class='contents'>
			<div
				class='grid-box box-height-1 col-[2/12] row-[13/14] grid px-2 md:col-[7/10] md:row-[5/6]'>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Set</span>

					<select
						name='set'
						id='avatar-set'
						class='select col-[4/11] w-full md:col-[2/4]'
						onchange='updatePreview(event)'>
						<option value=''></option>
						{
							avatarSets.map((set) => (
								<option
									value={set}
									selected={avatar.set.value === set}>
									{set}
								</option>
							))
						}
					</select>
				</label>
			</div>

			<div
				class={'grid-box box-height-1 col-[2/12] grid px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'hidden' : 'row-[14/15] md:row-[6/7]')}>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Id</span>

					<select
						name='id'
						id='avatar-id'
						class='select col-[4/11] w-full md:col-[2/4]'
						onchange='updatePreview(event)'>
						<option value=''></option>
						{
							avatarIdsMap[avatar.set.value].map((id) => (
								<option
									value={id}
									selected={avatar.id.value === id}>
									{id}
								</option>
							))
						}
					</select>
				</label>
			</div>

			<div
				class={'grid-box box-height-1 col-[2/12] grid px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'row-[14/15] md:row-[6/7]' : 'row-[15/16] md:row-[7/8]')}>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Size</span>

					<select
						name='size'
						id='avatar-size'
						class='select col-[4/11] w-full md:col-[2/4]'
						onchange='updatePreview(event)'>
						<option value=''></option>
						{
							avatarSizes.map((size) => (
								<option
									value={size}
									selected={avatar.size.value === size}>
									{size}
								</option>
							))
						}
					</select>
				</label>
			</div>

			<div
				class={'grid-box box-height-1 col-[2/12] grid px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'row-[15/16] md:row-[7/8]' : 'row-[16/17] md:row-[8/9]')}>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Format</span>

					<select
						name='format'
						id='avatar-format'
						class='select col-[4/11] w-full md:col-[2/4]'
						onchange='updatePreview(event)'>
						<option value=''></option>
						{
							avatarFormats.map((format) => (
								<option
									value={format}
									selected={avatar.format.value === format}>
									{format}
								</option>
							))
						}
					</select>
				</label>
			</div>

			<div
				class={'grid-box box-height-1 col-[2/12] grid px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'hidden' : 'row-[17/18] md:row-[9/10]')}>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Text</span>

					<input
						name='text'
						id='avatar-text'
						type='text'
						maxlength='2'
						class='input col-[4/11] w-full md:col-[2/4]'
						value={avatar.text.value}
						onchange='updatePreview(event)'
					/>
				</label>
			</div>

            {avatar.set.value === 'builder' && (
            <div class='contents'>
                <div class='grid-box box-height-1 col-[2/12] row-[16/17] grid px-2 md:col-[7/10] md:row-[8/9]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Age</span>
                        <select name='age' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            <option value='child' selected={avatar.builderConfig.age === 'child'}>Child</option>
                            <option value='adult' selected={avatar.builderConfig.age === 'adult'}>Adult</option>
                            <option value='elder' selected={avatar.builderConfig.age === 'elder'}>Elder</option>
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[17/18] grid px-2 md:col-[7/10] md:row-[9/10]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Gender</span>
                        <select name='gender' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            <option value='male' selected={avatar.builderConfig.gender === 'male'}>Male</option>
                            <option value='female' selected={avatar.builderConfig.gender === 'female'}>Female</option>
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[18/19] grid px-2 md:col-[7/10] md:row-[10/11]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Skin</span>
                        <input name='skinTone' type='color' class='input col-[4/11] w-full md:col-[2/4]' value={avatar.builderConfig.skinTone} onchange='updatePreview(event)' />
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[19/20] grid px-2 md:col-[7/10] md:row-[11/12]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Hair</span>
                        <select name='hair' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['short', 'long', 'spiky', 'bald', 'curly', 'bob'].map(h => <option value={h} selected={avatar.builderConfig.hair === h}>{h}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[20/21] grid px-2 md:col-[7/10] md:row-[12/13]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Hair Color</span>
                        <input name='hairColor' type='color' class='input col-[4/11] w-full md:col-[2/4]' value={avatar.builderConfig.hairColor} onchange='updatePreview(event)' />
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[21/22] grid px-2 md:col-[7/10] md:row-[13/14]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Clothing</span>
                        <select name='clothing' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['shirt', 'hoodie', 'suit', 'dress'].map(c => <option value={c} selected={avatar.builderConfig.clothing === c}>{c}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[22/23] grid px-2 md:col-[7/10] md:row-[14/15]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Cloth Color</span>
                        <input name='clothingColor' type='color' class='input col-[4/11] w-full md:col-[2/4]' value={avatar.builderConfig.clothingColor} onchange='updatePreview(event)' />
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[23/24] grid px-2 md:col-[7/10] md:row-[15/16]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Accessory</span>
                        <select name='accessory' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['none', 'glasses', 'sunglasses', 'headphones', 'cap'].map(a => <option value={a} selected={avatar.builderConfig.accessory === a}>{a}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[24/25] grid px-2 md:col-[7/10] md:row-[16/17]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Background</span>
                        <input name='background' type='color' class='input col-[4/11] w-full md:col-[2/4]' value={avatar.builderConfig.background} onchange='updatePreview(event)' />
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[25/26] grid px-2 md:col-[7/10] md:row-[17/18]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Eyes</span>
                        <select name='eyes' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['normal', 'wide', 'closed', 'squint', 'tired', 'look_away'].map(e => <option value={e} selected={avatar.builderConfig.eyes === e}>{e}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[26/27] grid px-2 md:col-[7/10] md:row-[18/19]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Brows</span>
                        <select name='brows' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['neutral', 'raised', 'angry', 'sad', 'flat'].map(b => <option value={b} selected={avatar.builderConfig.brows === b}>{b}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 col-[2/12] row-[27/28] grid px-2 md:col-[7/10] md:row-[19/20]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Mouth</span>
                        <select name='mouth' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['neutral', 'smile', 'big_smile', 'sad', 'open', 'smirk', 'teeth', 'gasp'].map(m => <option value={m} selected={avatar.builderConfig.mouth === m}>{m}</option>)}
                        </select>
                    </label>
                </div>

                <div class='grid-box box-height-1 grid-cross-bl col-[2/12] row-[28/29] grid px-2 md:col-[7/10] md:row-[20/21]'>
                    <label class='label grid grid-cols-10 md:grid-cols-3'><span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Builder.</span>Expression</span>
                        <select name='expression' class='select col-[4/11] w-full md:col-[2/4]' onchange='updatePreview(event)'>
                            {['none', 'Neutral', 'Feliz', 'Sorprendido', 'Concentrado', 'Triste', 'Enojado', 'Asustado', 'Confundido', 'Cansado', 'Avergonzado', 'Emocionado', 'Arrogante', 'Aburrido', 'Sarcástico', 'Aliviado', 'Sonrisa pícara'].map(e => <option value={e} selected={avatar.builderConfig.expression === e}>{e}</option>)}
                        </select>
                    </label>
                </div>
            </div>
            )}


			<div
				class={'grid-box box-height-1 grid-cross-bl col-[2/12] grid px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'hidden' : 'row-[18/19] md:row-[10/11]')}>
				<label class='label grid grid-cols-10 md:grid-cols-3'>
					<span class='col-[1/4] md:col-[1/2]'><span class='font-light'>Avatar.</span>Color</span>

					<input
						name='color'
						id='avatar-color'
						type='color'
						class='input col-[4/11] w-full md:col-[2/4]'
						value={avatar.color.value}
						onchange='updatePreview(event)'
					/>
				</label>
			</div>

			<div
				class={'grid-box box-height-1 col-[2/12] grid grid-cols-2 items-center gap-2 px-2 md:col-[7/10] ' + (avatar.set.value === 'builder' ? 'row-[29/30] md:row-[21/22]' : 'row-[20/21] md:row-[12/13]')}>
				<button
					type='button'
					class='btn btn-secondary'
					onclick='
						document.querySelectorAll("input, select").forEach(el => {
							if (el.type === "radio" || el.type === "checkbox") {
								el.checked = false;
							} else {
								el.value = "";
							}
						});
						this.form.submit();
					'>
					Reset
				</button>

				<button
					type='button'
					class='btn btn-primary'
					onclick='window.location.replace("/")'>
					<Icon name='dice' />
					Random
				</button>
			</div>
		</form>

		<AvatarCode
			class='grid-box box-height-2 col-[1/13] row-[22/24] content-center overflow-hidden p-3 text-center md:col-[3/11] md:row-[14/16]'
			code={avatar.codeurl}
			wrap={true}
		/>
	</main>
<script is:inline>
function updatePreview(e) {
	const form = document.querySelector('form');

    if (e && e.target && e.target.name === 'set') {
        form.submit();
        return;
    }

	const url = new URL(form.action || window.location.href);
	const params = new URLSearchParams();

	const formData = new FormData(form);
	for (const [key, value] of formData.entries()) {
		if (value) params.set(key, value);
	}

	const isBuilder = formData.get('set') === 'builder';

	let apiUrl = '/api/avatar';
	if (Array.from(params.keys()).length > 0) {
		apiUrl += '?' + params.toString();
	}

	if (isBuilder) {
		document.getElementById('preview').src = apiUrl;
		const codeBlock = document.querySelector('pre');
		if (codeBlock) {
			const fullUrl = window.location.origin + apiUrl;

			// Update the text directly. Shiki will be blown away, but the URL will be correct and copyable.
			codeBlock.textContent = fullUrl;

			// Also update history state so URL bar reflects the changes without reload
			const playgroundUrl = new URL(window.location.href);
            playgroundUrl.search = params.toString();
            window.history.replaceState({}, '', playgroundUrl.toString());
		}
	} else {
		form.submit();
	}
}
</script>



</Layout>
